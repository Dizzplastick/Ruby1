@page "/register"
@attribute [AllowAnonymous]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Ruby.Shared.DTO.UserDTO
@using Ruby.UI.Services.Api
@using Ruby.UI.Services.HttpHandlers
@using Ruby.UI.Services
@inject IAuthApi AuthApi
@inject ITokenStorageService TokenStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager


<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column " Style="min-height: 85vh;">

<EditForm Model="@formModel" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudCard>
                <MudCardContent>
                        <MudTextField Label="Username" HelperText="Max. 20 characters"
                                  @bind-Value="formModel.Username" For="@(() => formModel.Username)" />
                    <MudTextField Label="Email" Class="mt-3"
                                  @bind-Value="formModel.Email" For="@(() => formModel.Email)" />
                    <MudTextField Label="Password" HelperText="Choose a strong password" Class="mt-3"
                                  @bind-Value="formModel.Password" For="@(() => formModel.Password)" InputType="InputType.Password" />
                    <MudTextField Label="Password" HelperText="Repeat the password" Class="mt-3"
                                  @bind-Value="formModel.Password2" For="@(() => formModel.Password2)" InputType="InputType.Password" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Class="ml-auto">Register</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudPaper Class="pa-4 mud-height-full">
                <MudText Typo="Typo.subtitle2">Validation Summary</MudText>
                @if (success)
                {
                    <MudText Color="Color.Success">Success</MudText>
                }
                else
                {
                    <MudText Color="@Color.Error">
                        <ValidationSummary />
                    </MudText>
                }
            </MudPaper>
        </MudItem>
            <MudItem xs="12" Class="d-flex justify-center mt-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Already have an account?
                    <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Always" Class="ml-1">
                        Log In here
                    </MudLink>
                </MudText>
            </MudItem>
    </MudGrid>
</EditForm>
</MudContainer>


@code {
    RegisterAccountForm formModel = new RegisterAccountForm();
    bool success;

    public class RegisterAccountForm
    {
        [Required]
        [StringLength(20, ErrorMessage = "The name cannot be longer than 20 characters and less than 3.", MinimumLength = 3)]
        public string Username { get; set; }

        [Required]
        [EmailAddress]
        public string Email { get; set; }

        [Required]
        [StringLength(50, ErrorMessage = "Password must be at least 6 characters long.", MinimumLength = 6)]
        public string Password { get; set; }

        [Required]
        [Compare(nameof(Password))]
        public string Password2 { get; set; }

    }

    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var requestDto = new UserRegisterRequestDTO
            {
                Username = formModel.Username,
                Email = formModel.Email,
                Password = formModel.Password
            };


            var response = await AuthApi.RegisterAsync(requestDto);

            await TokenStorage.SaveTokensAsync(response.Token, response.RefreshToken);

            ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLoggedIn();

            NavigationManager.NavigateTo("/main");
        }
        catch (Refit.ApiException ex)
        {
            errorMessage = "Registration error. That username or email address may already be taken.";
            
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while connecting to the server.";
        }
        finally
        {
            isLoading = false;
        }
    }
}